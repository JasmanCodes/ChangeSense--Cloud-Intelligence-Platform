# ChangeSense Environment Variables

# Backend Port and Environment
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/changesense?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET=changesense-super-secret-access-token-key-2026!
JWT_REFRESH_SECRET=changesense-super-secret-refresh-token-key-2026!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here

# Demo Mode Settings
DEMO_MODE_DEFAULT=true

# ChangeSense Host Account (For IAM Trust Relationship Display)
CHANGESENSE_AWS_ACCOUNT_ID=123456789012
